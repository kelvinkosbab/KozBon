    "NSLocalNetworkUsageDescription" : {
      "comment" : "Permission prompt shown the first time KozBon browses the local network. Explains why the app needs local network access to find and publish Bonjour services.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتاج KozBon إلى إذن للبحث عن خدمات Bonjour القريبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KozBon benötigt die Berechtigung, in deiner Nähe nach Bonjour-Diensten zu suchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KozBon needs permission to scan for nearby Bonjour services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KozBon necesita permiso para buscar servicios Bonjour cercanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KozBon a besoin d'accéder au réseau local pour rechercher les services Bonjour à proximité."
