    "List Discovered Services": {
      "comment": "Short title on the shortcut tile in the Shortcuts app. Key is the literal from AppShortcut(shortTitle:). Lives here, not in AppShortcuts.xcstrings — that catalog accepts spoken phrases only.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سرد الخدمات المكتشفة"
