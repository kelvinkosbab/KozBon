    "intent_scan_description": {
      "comment": "Shortcuts-app description for the scan action.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث عن خدمات Bonjour على شبكتك المحلية لبضع ثوانٍ ويخبرك بعدد ما تم العثور عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht einige Sekunden lang nach Bonjour-Diensten im lokalen Netzwerk und nennt die Anzahl der gefundenen Dienste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans for Bonjour services on your local network for a few seconds and tells you how many were found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca servicios Bonjour en tu red local durante unos segundos y te dice cuántos ha encontrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche les services Bonjour sur votre réseau local pendant quelques secondes et vous indique combien ont été trouvés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סורק שירותי Bonjour ברשת המקומית במשך כמה שניות ומדווח כמה נמצאו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク上のBonjourサービスを数秒間スキャンし、見つかった数をお知らせします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地网络中扫描 Bonjour 服务几秒钟，并告诉您找到了多少个。"
          }
        }
      }
    },
