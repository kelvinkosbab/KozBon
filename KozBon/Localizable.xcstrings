    "intent_list_description": {
      "comment": "Shortcuts-app description for the list action. 'Shortcuts' is the Apple app name and uses each locale's official app name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد خدمات Bonjour المكتشفة على شبكتك المحلية. استخدمه في تطبيق الاختصارات لتمرير قائمة الخدمات إلى الخطوة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet die im lokalen Netzwerk gefundenen Bonjour-Dienste auf. In Kurzbefehle kannst du die Liste an den nächsten Schritt übergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists Bonjour services discovered on your local network. Use this in Shortcuts to feed the list of services into the next step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera los servicios Bonjour descubiertos en tu red local. Úsalo en Atajos para pasar la lista de servicios al siguiente paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les services Bonjour découverts sur votre réseau local. Utilisez cette action dans Raccourcis pour transmettre la liste des services à l'étape suivante."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את שירותי Bonjour שהתגלו ברשת המקומית. אפשר להשתמש בפעולה הזו בקיצורי דרך כדי להעביר את רשימת השירותים לשלב הבא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークで検出されたBonjourサービスを一覧表示します。ショートカットで次のステップにサービスのリストを渡すために使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出在本地网络中发现的 Bonjour 服务。在“快捷指令”中使用它，将服务列表传递到下一步。"
          }
        }
      }
    },
    "intent_list_title": {
      "comment": "Title of the Siri/Shortcuts action that returns the discovered services as a list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سرد الخدمات المكتشفة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefundene Dienste auflisten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List Discovered Services"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumerar servicios descubiertos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lister les services découverts"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת השירותים שהתגלו"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出されたサービスを一覧表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出已发现的服务"
          }
        }
      }
    },
    "intent_online_description": {
      "comment": "Description of a Siri/Shortcuts action, shown in the Shortcuts editor.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص شبكتك ويخبرك ما إذا كان جهاز ما موجودًا عليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht dein Netzwerk und sagt dir, ob ein Gerät darin ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans your network and tells you whether a device is on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora tu red y te dice si un dispositivo está en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse votre réseau et vous indique si un appareil s’y trouve."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סורק את הרשת שלך ומודיע אם מכשיר נמצא בה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークをスキャンし、デバイスがネットワーク上にあるかどうかを伝えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描你的网络，告诉你某台设备是否在网络上。"
          }
        }
      }
    },
    "intent_online_title": {
      "comment": "Title of a Siri/Shortcuts action. Verb + noun, title case.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من اتصال جهاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen, ob ein Gerät online ist"
