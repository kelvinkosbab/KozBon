    "intent_stop_broadcast_description": {
      "comment": "Description of a Siri/Shortcuts action, shown in the Shortcuts editor.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف كل الخدمات التي يبثها KozBon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet alle Dienste, die KozBon überträgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops every service KozBon is broadcasting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene todos los servicios que KozBon está transmitiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête tous les services que KozBon diffuse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפסיק את כל השירותים ש-KozBon משדרת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KozBonがブロードキャストしているすべてのサービスを停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 KozBon 正在广播的所有服务。"
          }
        }
      }
    },
