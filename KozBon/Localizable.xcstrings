    "intent_list_description": {
      "comment": "Shortcuts-app description for the list action. 'Shortcuts' is the Apple app name and uses each locale's official app name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد خدمات Bonjour المكتشفة على شبكتك المحلية. استخدمه في تطبيق الاختصارات لتمرير قائمة الخدمات إلى الخطوة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet die im lokalen Netzwerk gefundenen Bonjour-Dienste auf. In Kurzbefehle kannst du die Liste an den nächsten Schritt übergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists Bonjour services discovered on your local network. Use this in Shortcuts to feed the list of services into the next step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera los servicios Bonjour descubiertos en tu red local. Úsalo en Atajos para pasar la lista de servicios al siguiente paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les services Bonjour découverts sur votre réseau local. Utilisez cette action dans Raccourcis pour transmettre la liste des services à l'étape suivante."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את שירותי Bonjour שהתגלו ברשת המקומית. אפשר להשתמש בפעולה הזו בקיצורי דרך כדי להעביר את רשימת השירותים לשלב הבא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークで検出されたBonjourサービスを一覧表示します。ショートカットで次のステップにサービスのリストを渡すために使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出在本地网络中发现的 Bonjour 服务。在“快捷指令”中使用它，将服务列表传递到下一步。"
          }
        }
      }
    },
