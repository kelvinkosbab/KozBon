          }
        }
      }
    },
    "intent_open_description": {
      "comment": "Description of a Siri/Shortcuts action, shown in the Shortcuts editor.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح KozBon على تفاصيل خدمة أعادها الإجراء عرض أو بحث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet KozBon mit den Details eines Dienstes, den Auflisten oder Suchen geliefert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens KozBon on the details of a service that List or Find returned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre KozBon en los detalles de un servicio que devolvió Listar o Buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre KozBon sur les détails d’un service renvoyé par Lister ou Rechercher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את KozBon בפרטים של שירות שהוחזר מרשימה או מחיפוש."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧表示または検索で返されたサービスの詳細をKozBonで開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 KozBon 中打开由“列出”或“查找”返回的服务的详细信息。"
          }
        }
      }
    },
