    "intent_broadcast_description": {
      "comment": "Description of a Siri/Shortcuts action, shown in the Shortcuts editor.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعلن عن خدمة Bonjour من هذا الجهاز على المنفذ الذي تختاره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kündigt einen Bonjour-Dienst von diesem Gerät auf dem gewählten Port an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertises a Bonjour service from this device on the port you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncia un servicio Bonjour desde este dispositivo en el puerto que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonce un service Bonjour depuis cet appareil sur le port de votre choix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפרסם שירות Bonjour מהמכשיר הזה ביציאה שבחרת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したポートで、このデバイスからBonjourサービスを公開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你选择的端口上从这台设备公布 Bonjour 服务。"
          }
        }
      }
    },
