    "intent_explain_description": {
      "comment": "Description of a Siri/Shortcuts action, shown in the Shortcuts editor.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشرح نوع خدمة Bonjour في بضع جمل باستخدام الذكاء الاصطناعي المحدد في KozBon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärt einen Bonjour-Diensttyp in wenigen Sätzen mit der in KozBon gewählten KI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explains a Bonjour service type in a few sentences, using the AI selected in KozBon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica un tipo de servicio Bonjour en pocas frases con la IA seleccionada en KozBon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique un type de service Bonjour en quelques phrases avec l’IA choisie dans KozBon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסביר סוג שירות Bonjour בכמה משפטים באמצעות הבינה המלאכותית שנבחרה ב-KozBon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KozBonで選択したAIを使って、Bonjourサービスタイプを数文で解説します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 KozBon 中选择的 AI，用几句话解读一种 Bonjour 服务类型。"
          }
        }
      }
    },
    "intent_explain_title": {
      "comment": "Title of a Siri/Shortcuts action. Verb + noun, title case.",
