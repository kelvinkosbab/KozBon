    "intent_find_description": {
      "comment": "Description of a Siri/Shortcuts action, shown in the Shortcuts editor.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص شبكتك ويعرض فقط الخدمات التي تنتمي إلى فئة أو نوع معيّن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht dein Netzwerk und gibt nur die Dienste einer Kategorie oder eines Typs zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans your network and returns only the services in a category or of one type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora tu red y devuelve solo los servicios de una categoría o de un tipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse votre réseau et ne renvoie que les services d’une catégorie ou d’un type."
          }
        },
        "he": {
